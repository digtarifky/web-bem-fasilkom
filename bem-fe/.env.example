# =============================================
# BEM FASILKOM - Frontend Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# =============================================

# URL base API backend Laravel
# Contoh production: https://api.bem-fasilkom.example.com/api
PUBLIC_API_URL=https://your-backend-url.com/api

# URL storage backend untuk aset yang di-upload (foto, dokumen, dll)
# Contoh production: https://api.bem-fasilkom.example.com/storage
PUBLIC_STORAGE_URL=https://your-backend-url.com/storage
