---
// src/components/common/Navbar.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Struktur', href: '/struktur-kabinet' },
  { name: 'Berita', href: '/berita' },
  { name: 'Advo Center', href: '/advo' },
];
---

<header class="fixed top-0 left-0 w-full z-50 pointer-events-none flex justify-center">
  <div
    id="nav-liquid"
    class="pointer-events-auto w-full nav-top flex items-center justify-between text-neutral-900 isolate transform-gpu border border-white/45 shadow-[0_8px_32px_0_rgba(0,0,0,0.06)]"
    style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.38) 0%, rgba(240, 243, 246, 0.18) 50%, rgba(255, 255, 255, 0.28) 100%); -webkit-backdrop-filter: blur(32px) saturate(200%); backdrop-filter: blur(32px) saturate(200%);"
  >
    <div class="max-w-7xl 2xl:max-w-[1440px] mx-auto flex items-center justify-between w-full">
      
      <!-- Brand & Logo -->
      <a href="/" class="flex items-center gap-4 group shrink-0">
        <img 
          src="/assets/logo/logo-bem.svg" 
          alt="Logo BEM FASILKOM" 
          class="w-10 h-10 md:w-11 md:h-11 object-contain group-hover:scale-105 transition-transform drop-shadow-xs" 
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none'"
        />
        <div class="flex flex-col font-helvetica">
          <span class="font-bold text-base md:text-[17px] tracking-wide leading-tight text-sunset-orange drop-shadow-xs">
            BEM FASILKOM <span class="text-sunset-orange">2026</span>
          </span>
          <div class="inline-flex items-baseline">
            <span class="font-pinyon not-italic text-xl md:text-2xl text-neutral-900 leading-none">
              K
            </span>
            <span class="font-helvetica italic font-semibold text-xs md:text-sm text-neutral-800 leading-none">
              abinet Aetherion
            </span>
          </div>
        </div>
      </a>

      <!-- Menu Navigasi Bersih -->
      <nav id="nav-menu" class="hidden lg:flex relative items-center">
        <!-- Kotak Rounded Aktif Meluncur (Liquid Glass Pebble Sesuai Gambar 2) -->
        <div
          id="sliding-indicator"
          class="absolute top-0 bottom-0 left-0 rounded-full transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] pointer-events-none opacity-0"
          style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.22) 100%); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.65); box-shadow: inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.8), 0 3px 12px 0 rgba(0, 0, 0, 0.06);"
        ></div>

        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              data-nav-item
              class={`nav-link-btn relative z-10 px-6 py-2.5 rounded-full text-sm md:text-[15px] font-semibold transition-colors duration-200 select-none ${
                isActive ? 'text-neutral-950 font-bold is-active' : 'text-neutral-700 hover:text-neutral-950 hover:bg-white/15'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Button -->
      <button id="mobile-toggle" class="lg:hidden p-3 rounded-2xl text-neutral-800 hover:text-neutral-950 bg-white/30 hover:bg-white/50 border border-white/50 backdrop-blur-md shadow-xs transition-all" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-drawer" 
    class="hidden lg:hidden fixed top-22 left-4 right-4 rounded-3xl p-4 flex-col gap-2 pointer-events-auto isolate transform-gpu"
    style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.55) 0%, rgba(240, 243, 246, 0.3) 100%); -webkit-backdrop-filter: blur(32px) saturate(200%); backdrop-filter: blur(32px) saturate(200%); border: 1px solid rgba(255, 255, 255, 0.5); box-shadow: inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.75), 0 24px 60px rgba(0, 0, 0, 0.15);"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="px-4 py-2.5 text-sm font-medium rounded-xl text-neutral-700 hover:text-neutral-950 hover:bg-white/40 transition-colors"
      >
        {link.name}
      </a>
    ))}
  </div>
</header>

<style>
  /* 1. STATE AWAL: FULL LEBAR DI PALING ATAS */
  .nav-top {
    max-width: 100% !important;
    width: 100% !important;
    transform: translate3d(0, 0, 0) !important;
    border-radius: 0px !important;
    padding: 1.35rem 3rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.2) 100%) !important;
    backdrop-filter: blur(32px) saturate(200%) brightness(102%) !important;
    -webkit-backdrop-filter: blur(32px) saturate(200%) brightness(102%) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45) !important;
    box-shadow: 
      inset 0 -1px 1.5px 0 rgba(255, 255, 255, 0.3),
      0 4px 20px -4px rgba(0, 0, 0, 0.04) !important;
    will-change: transform, max-width, border-radius, padding;
    /* Transisi kembali ke atas: Cepat & Natural (0.22s) */
    transition: 
      transform 0.22s cubic-bezier(0, 0, 0.2, 1),
      max-width 0.22s cubic-bezier(0, 0, 0.2, 1),
      border-radius 0.22s cubic-bezier(0, 0, 0.2, 1),
      padding 0.2s ease,
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* 2. STATE SCROLLED: LIQUID GLASSMORPHISM PILL (Persis Sesuai Gambar 2) */
  .nav-scrolled {
    max-width: 1200px !important; /* Proporsi kapsul elegan */
    width: 92% !important;
    transform: translate3d(0, 16px, 0) !important;
    border-radius: 9999px !important;
    padding: 0.95rem 2.75rem !important;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.38) 0%, rgba(240, 243, 246, 0.18) 50%, rgba(255, 255, 255, 0.28) 100%) !important;
    backdrop-filter: blur(32px) saturate(200%) brightness(102%) !important;
    -webkit-backdrop-filter: blur(32px) saturate(200%) brightness(102%) !important;
    border: 1px solid rgba(255, 255, 255, 0.45) !important;
    border-top: 1.5px solid rgba(255, 255, 255, 0.75) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25) !important;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1.5px 2px 0 rgba(255, 255, 255, 0.18),
      inset 0 0 20px 0 rgba(255, 255, 255, 0.12),
      0 20px 45px -10px rgba(0, 0, 0, 0.1),
      0 6px 18px -4px rgba(0, 0, 0, 0.04) !important;
    will-change: transform, max-width, border-radius, padding;
    /* Transisi scroll ke bawah: Ultra Smooth, Mewah & Mengalir (0.55s) */
    transition: 
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      max-width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.55s ease;
  }
</style>

<script>
  function initNavbar() {
    const nav = document.getElementById('nav-liquid');
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const indicator = document.getElementById('sliding-indicator');
    const navItems = document.querySelectorAll<HTMLAnchorElement>('[data-nav-item]');

    if (!nav) return;

    // 1. Mobile Drawer Toggle
    mobileToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileDrawer?.classList.toggle('hidden');
    });

    // 2. Sliding Indicator Position
    const moveIndicator = (target: HTMLElement | null) => {
      if (!target || !indicator) return;
      indicator.style.width = `${target.offsetWidth}px`;
      indicator.style.transform = `translateX(${target.offsetLeft}px)`;
      indicator.style.opacity = '1';
    };

    const updateIndicatorToActive = () => {
      const activeItem = (document.querySelector('[data-nav-item].is-active') as HTMLElement) || (navItems[0] as HTMLElement);
      moveIndicator(activeItem);
    };

    // 3. Sinkronisasi Tautan Aktif Berdasarkan URL Terkini
    const syncActiveNavLink = () => {
      const currentPath = window.location.pathname;
      navItems.forEach((item) => {
        const href = item.getAttribute('href');
        const isActive = href === currentPath || (href !== '/' && href !== '' && currentPath.startsWith(href || ''));
        if (isActive) {
          item.classList.add('text-neutral-950', 'font-bold', 'is-active');
          item.classList.remove('text-neutral-600');
        } else {
          item.classList.remove('text-neutral-950', 'font-bold', 'is-active');
          item.classList.add('text-neutral-600');
        }
      });
      updateIndicatorToActive();
    };

    // 4. Update Status Navbar (Liquid Scrolled vs Top)
    // Cek langsung class DOM agar kebal bug desinkronisasi BFCache / History Back-Forward
    const updateNavbarState = () => {
      const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
      const isCurrentlyScrolled = nav.classList.contains('nav-scrolled');

      if (scrollY > 20 && !isCurrentlyScrolled) {
        nav.classList.remove('nav-top');
        nav.classList.add('nav-scrolled');
        setTimeout(updateIndicatorToActive, 180);
      } else if (scrollY <= 10 && isCurrentlyScrolled) {
        nav.classList.remove('nav-scrolled');
        nav.classList.add('nav-top');
        setTimeout(updateIndicatorToActive, 140);
      }
    };

    // 5. Scroll Handler dengan Throttling via requestAnimationFrame yang Aman
    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateNavbarState();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', updateIndicatorToActive);

    // Click handler untuk nav items
    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navItems.forEach((el) => {
          el.classList.remove('text-neutral-950', 'font-bold', 'is-active');
          el.classList.add('text-neutral-600');
        });
        item.classList.add('text-neutral-950', 'font-bold', 'is-active');
        item.classList.remove('text-neutral-600');
        moveIndicator(item);
      });
    });

    // 6. Penanganan Khusus BFCache (Back/Forward Cache Browser) & History Popstate
    // Saat user menekan tombol 'Back' browser, event ini WAJIB mereset ticking dan menyelaraskan class
    const handleNavigationRestore = () => {
      ticking = false;
      syncActiveNavLink();
      updateNavbarState();
      // Browser sering merestorasi scroll position secara asinkron
      setTimeout(updateNavbarState, 60);
      setTimeout(updateNavbarState, 200);
      setTimeout(updateIndicatorToActive, 250);
    };

    window.addEventListener('pageshow', handleNavigationRestore);
    window.addEventListener('popstate', handleNavigationRestore);
    document.addEventListener('astro:page-load', handleNavigationRestore);

    // Initial run saat halaman pertama dimuat
    syncActiveNavLink();
    updateNavbarState();
  }

  // Jalankan saat script dimuat
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>