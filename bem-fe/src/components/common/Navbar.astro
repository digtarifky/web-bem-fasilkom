---
// src/components/common/Navbar.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Struktur', href: '/struktur' },
  { name: 'Berita', href: '/berita' },
  { name: 'Advo Center', href: '/advo' },
];
---

<header class="fixed top-0 left-0 w-full z-50 pointer-events-none flex justify-center">
  <div
    id="nav-liquid"
    class="pointer-events-auto w-full nav-top flex items-center justify-between text-black"
  >
    <div class="max-w-7xl mx-auto flex items-center justify-between w-full">
      
      <!-- Brand & Logo -->
      <a href="/" class="flex items-center gap-3.5 group shrink-0">
        <img 
          src="/assets/logo/logo-bem.svg" 
          alt="Logo BEM FASILKOM" 
          class="w-9 h-9 object-contain group-hover:scale-105 transition-transform" 
        />
        <div class="flex flex-col">
          <span class="font-serif font-bold text-sm md:text-base tracking-wide leading-tight text-black drop-shadow-sm">
            BEM FASILKOM <span class="text-sunset-orange">2026</span>
          </span>
          <span class="text-[10px] md:text-[11px] font-mono tracking-widest text-warm-gold font-semibold uppercase">
            KABINET AETHERION
          </span>
        </div>
      </a>

      <!-- Menu Navigasi Bersih -->
      <nav id="nav-menu" class="hidden lg:flex relative items-center">
        <!-- Kotak Rounded Aktif Meluncur -->
        <div
          id="sliding-indicator"
          class="absolute top-0 bottom-0 left-0 rounded-full bg-white/15 border border-white/25 shadow-[inset_0_1px_1px_rgba(255,255,255,0.4)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] pointer-events-none opacity-0"
        ></div>

        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              data-nav-item
              class={`nav-link-btn relative z-10 px-5 py-2 rounded-full text-xs md:text-sm font-medium transition-colors duration-200 select-none ${
                isActive ? 'text-black font-semibold is-active' : 'text-black/70 hover:text-black'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Button -->
      <button id="mobile-toggle" class="lg:hidden p-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-colors" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="hidden lg:hidden fixed top-16 left-4 right-4 rounded-2xl bg-obsidian/95 backdrop-blur-2xl border border-white/15 p-4 flex-col gap-2 shadow-2xl pointer-events-auto">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="px-4 py-2.5 text-sm font-medium rounded-xl text-white/80 hover:text-white hover:bg-white/10 transition-colors"
      >
        {link.name}
      </a>
    ))}
  </div>
</header>

<style>
  /* 1. STATE AWAL: FULL LEBAR DI PALING ATAS */
  .nav-top {
    max-width: 100% !important;
    width: 100% !important;
    transform: translate3d(0, 0, 0) !important;
    border-radius: 0px !important;
    padding: 1.15rem 2.5rem;
    background-color: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: none;
    will-change: transform, max-width, border-radius, padding;
    /* Transisi kembali ke atas: Cepat & Natural (0.22s) */
    transition: 
      transform 0.22s cubic-bezier(0, 0, 0.2, 1),
      max-width 0.22s cubic-bezier(0, 0, 0.2, 1),
      border-radius 0.22s cubic-bezier(0, 0, 0.2, 1),
      padding 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  /* 2. STATE SCROLLED: LIQUID GLASS LEGA & ULTRA SMOOTH */
  .nav-scrolled {
    max-width: 1200px !important; /* Ukuran ideal: tidak terlalu sempit */
    width: 94% !important;
    transform: translate3d(0, 16px, 0) !important;
    border-radius: 9999px !important;
    padding: 0.85rem 2.25rem !important; /* Proporsi tinggi lebih nyaman */
    background-color: rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.5),
      0 18px 40px -10px rgba(0, 0, 0, 0.6) !important;
    will-change: transform, max-width, border-radius, padding;
    /* Transisi scroll ke bawah: Ultra Smooth, Mewah & Mengalir (0.55s) */
    transition: 
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      max-width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.55s ease;
  }
</style>

<script>
  // A. Scroll Detection & Class Switcher
  const nav = document.getElementById('nav-liquid');
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileDrawer = document.getElementById('mobile-drawer');

  mobileToggle?.addEventListener('click', () => {
    mobileDrawer?.classList.toggle('hidden');
  });

  let isFloating = false;
  let ticking = false;

  const updateNavbar = () => {
    if (!nav) return;
    const scrollY = window.scrollY;

    // Hysteresis yang stabil: Aktif saat scroll > 20px, reset saat mentok ke atas (<= 5px)
    if (scrollY > 20 && !isFloating) {
      isFloating = true;
      nav.classList.remove('nav-top');
      nav.classList.add('nav-scrolled');
      // Perbarui posisi indicator saat navbar mengecil
      setTimeout(initIndicator, 200);
    } else if (scrollY <= 5 && isFloating) {
      isFloating = false;
      nav.classList.remove('nav-scrolled');
      nav.classList.add('nav-top');
      // Perbarui posisi indicator saat navbar melebar penuh
      setTimeout(initIndicator, 150);
    }

    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateNavbar);
        ticking = true;
      }
    },
    { passive: true }
  );

  updateNavbar();

  // B. Sliding Pill Indicator Logic
  const indicator = document.getElementById('sliding-indicator');
  const navItems = document.querySelectorAll<HTMLAnchorElement>('[data-nav-item]');

  const moveIndicator = (target: HTMLElement | null) => {
    if (!target || !indicator) return;
    indicator.style.width = `${target.offsetWidth}px`;
    indicator.style.transform = `translateX(${target.offsetLeft}px)`;
    indicator.style.opacity = '1';
  };

  const initIndicator = () => {
    const activeItem = (document.querySelector('[data-nav-item].is-active') as HTMLElement) || (navItems[0] as HTMLElement);
    moveIndicator(activeItem);
  };

  initIndicator();

  navItems.forEach((item) => {
    item.addEventListener('click', () => {
      navItems.forEach((el) => {
        el.classList.remove('text-white', 'font-semibold', 'is-active');
        el.classList.add('text-white/70');
      });
      item.classList.add('text-white', 'font-semibold', 'is-active');
      item.classList.remove('text-white/70');
      moveIndicator(item);
    });
  });

  window.addEventListener('resize', initIndicator);
</script>