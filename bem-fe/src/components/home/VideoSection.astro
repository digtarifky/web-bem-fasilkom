---
// src/components/home/VideoSection.astro
---

<section id="video-profil" class="py-24 md:py-28 relative overflow-hidden bg-white text-neutral-900">
  <!-- Anchor for Navigation Profil & Misi -->
  <div id="profil-misi" class="absolute -top-20"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
    
    <!-- Header Section -->
    <div id="video-header" class="max-w-2xl mx-auto mb-10 md:mb-14 space-y-3">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-neutral-100 border border-neutral-300 text-[11px] font-mono font-bold text-sunset-orange uppercase tracking-wider shadow-sm">
        <span class="w-2 h-2 rounded-full bg-sunset-orange animate-pulse"></span>
        TAYANGAN PERDANA KABINET AETHERION 2026
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif font-extrabold text-neutral-900 tracking-tight">
        Video Profil & <span class="text-sunset-orange">Misi Strategis</span>
      </h2>
      <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed max-w-xl mx-auto">
        Kenali lebih dekat energi kabinet, nilai pergerakan, dan arah transformasi kami selama satu periode kepengurusan.
      </p>
    </div>

    <!-- 3D Perspective Wrapper -->
    <div class="video-perspective-wrapper relative max-w-5xl mx-auto" style="perspective: 1200px;">
      
      <!-- Ambient Backlight Glow (Desktop Only) -->
      <div 
        id="video-ambient-glow" 
        class="absolute -inset-4 bg-linear-to-r from-sunset-orange/40 via-warm-gold/30 to-sunset-orange/40 rounded-[3rem] blur-3xl opacity-20 pointer-events-none transform-gpu will-change-transform"
      ></div>

      <!-- Main Video Frame Mockup -->
      <div
        id="video-card-frame"
        class="relative aspect-video rounded-2xl sm:rounded-3xl bg-neutral-950 border border-white/20 p-2 sm:p-3 shadow-2xl shadow-black/30 will-change-transform transform-gpu overflow-hidden group cursor-pointer"
      >
        <div class="w-full h-full rounded-xl sm:rounded-2xl bg-linear-to-r from-neutral-900 via-obsidian to-neutral-950 flex flex-col justify-between p-4 sm:p-6 relative overflow-hidden">
          
          <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] [bg-size:20px_20px] pointer-events-none"></div>

          <!-- Top Bar -->
          <div class="relative z-10 flex items-center justify-between text-xs text-neutral-400 font-mono">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sunset-orange animate-pulse"></span>
              <span class="text-white font-semibold text-[10px] sm:text-xs tracking-wider">AETHERION OFFICIAL TEASER</span>
            </div>
            <span class="text-[9px] sm:text-[10px] px-2.5 py-0.5 rounded-full bg-white/10 text-neutral-300 border border-white/10 font-bold">
              PREVIEW ONLY
            </span>
          </div>

          <!-- Play Button Trigger -->
          <div class="relative z-10 flex items-center justify-center my-auto">
            <div class="relative flex items-center justify-center">
              <div class="absolute w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-sunset-orange/20 animate-ping pointer-events-none"></div>
              <button 
                id="video-play-btn"
                class="w-14 h-14 sm:w-20 sm:h-20 rounded-full bg-linear-to-br from-sunset-orange to-amber-500 text-white flex items-center justify-center shadow-xl shadow-sunset-orange/30 group-hover:scale-110 transition-transform duration-300"
                aria-label="Putar Video Profil"
              >
                <svg class="w-6 h-6 sm:w-8 sm:h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Bottom Bar Controls -->
          <div class="relative z-10 space-y-2">
            <div class="w-full h-1 sm:h-1.5 bg-white/15 rounded-full overflow-hidden">
              <div 
                id="video-progress-bar"
                class="w-1/3 h-full bg-gradient-to-r from-sunset-orange to-warm-gold rounded-full"
              ></div>
            </div>
            <div class="flex items-center justify-between text-[10px] sm:text-xs text-neutral-400 font-mono">
              <span>01:12 / 02:45</span>
              <div class="flex items-center gap-2">
                <span class="px-1.5 py-0.5 rounded bg-white/10 text-white text-[9px] sm:text-[10px]">1080p</span>
                <span>• 60FPS • <span class="text-warm-gold font-bold">KABINET AETHERION</span></span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initVideoSection() {
    const videoCard = document.getElementById('video-card-frame');
    const ambientGlow = document.getElementById('video-ambient-glow');
    const videoHeader = document.getElementById('video-header');

    if (videoCard) {
      // Fade in up header teks
      if (videoHeader) {
        gsap.from(videoHeader, {
          y: 25,
          opacity: 0,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '#video-profil',
            start: 'top 85%',
          },
        });
      }

      const mm = gsap.matchMedia();

      // 1. Desktop & Tablet (Full 3D Cinematic Tilt & Glow)
      mm.add('(min-width: 768px)', () => {
        gsap.fromTo(
          videoCard,
          {
            scale: 0.88,
            rotateX: 14,
            transformOrigin: '50% 100%',
          },
          {
            scale: 1,
            rotateX: 0,
            ease: 'none',
            scrollTrigger: {
              trigger: '#video-profil',
              start: 'top 70%',
              end: 'top 20%',
              scrub: 0.8,
            },
          }
        );

        if (ambientGlow) {
          gsap.fromTo(
            ambientGlow,
            { opacity: 0.15, scale: 0.85 },
            {
              opacity: 0.6,
              scale: 1.05,
              ease: 'none',
              scrollTrigger: {
                trigger: '#video-profil',
                start: 'top 70%',
                end: 'top 20%',
                scrub: 0.8,
              },
            }
          );
        }
      });

      // 2. Mobile (Ringan, Tanpa RotateX 3D, Bebas Lag)
      mm.add('(max-width: 767px)', () => {
        if (ambientGlow) {
          ambientGlow.style.display = 'none';
        }

        gsap.fromTo(
          videoCard,
          { scale: 0.94, opacity: 0.85 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.6,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: '#video-profil',
              start: 'top 80%',
            },
          }
        );
      });
    }

    // Modal Trigger integration
    const playBtn = document.getElementById('video-play-btn');
    const videoModal = document.getElementById('video-modal');
    if (videoCard && videoModal) {
      const openModal = () => {
        videoModal.classList.remove('opacity-0', 'pointer-events-none');
        videoModal.classList.add('opacity-100', 'pointer-events-auto');
      };
      videoCard.addEventListener('click', openModal);
      playBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        openModal();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initVideoSection);
  document.addEventListener('astro:page-load', initVideoSection);
</script>

