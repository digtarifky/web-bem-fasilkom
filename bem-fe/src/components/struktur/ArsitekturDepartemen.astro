---
// src/components/struktur/ArsitekturDepartemen.astro
// Desain node: kartu unit putih + kartu bidang di bawahnya, zig-zag kiri/kanan.
// Animasi:
//  1. Tiap node menempel (sticky) di tengah layar selama ±60svh.
//  2. Node membesar MIN_SCALE → 1, tertahan, lalu mengecil 1 → MIN_SCALE (scrub), berporos di sisi luar.
//  3. Garis lengkung oranye tergambar dari node ke node berikutnya (SVG pathLength=1).
//  4. Teks muncul per baris dari balik mask (SplitText).
import { units as semuaUnit, type Unit } from '../../data/struktur';
import { ICONS, type IconName } from './icons';

// Urutan tampil di section ini: MEDFO → SOSPOL → HDK → PSDM. Unit yang tidak terdaftar ditaruh di akhir.
const URUTAN = ['medfo', 'sospol', 'hdk', 'psdm'];
const posisi = (u: Unit) => { const i = URUTAN.indexOf(u.slug); return i === -1 ? URUTAN.length : i; };
const units = [...semuaUnit].sort((a, b) => posisi(a) - posisi(b));

const { ArrowRight } = ICONS;
const tipeLabel = (u: Unit) => (u.tipe === 'biro' ? 'Biro' : 'Departemen');
---

<section aria-labelledby="arsitektur-title" class="relative bg-[#FAFAFA] border-t border-neutral-200">
  <!-- Header section -->
  <div class="max-w-3xl mx-auto px-6 pt-24 sm:pt-32 pb-12 sm:pb-16 text-center space-y-4">
    <h2 id="arsitektur-title" data-ad-text class="text-3xl sm:text-5xl font-serif font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
      Struktur Organisasi <span class="text-sunset-orange"> <br> BEM Fasilkom</span>
    </h2>
    <p data-ad-text class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
      Aliran mandat berjenjang dan koordinasi struktural antar departemen teknis dalam melayani sivitas akademika.
    </p>
    <div class="w-12 h-1 mx-auto rounded-full bg-linear-to-r from-sunset-orange to-warm-gold"></div>
  </div>

  <div id="arsitektur-steps" class="relative max-w-7xl mx-auto px-6 md:px-12 pb-20 sm:pb-28">
    <!-- Garis penghubung antar node (desktop) -->
    <svg data-ad-links aria-hidden="true" class="hidden md:block absolute inset-0 w-full h-full overflow-visible pointer-events-none z-0">
      <defs>
        <linearGradient id="ad-stroke" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#EA580C" />
          <stop offset="100%" stop-color="#F59E0B" />
        </linearGradient>
      </defs>
      {units.slice(1).map(() => (
        <path data-ad-link pathLength="1" fill="none" stroke="url(#ad-stroke)" stroke-width="3" stroke-linecap="round" stroke-dasharray="1" stroke-dashoffset="1" />
      ))}
    </svg>

    <ol class="relative z-10 grid gap-y-10 md:gap-y-8">
      {units.map((u, i) => {
        // Unit terakhir (PSDM): penanda di atas, node di tengah bawahnya. Sisanya zig-zag.
        const center = i === units.length - 1;
        const flip = !center && i % 2 === 1; // genap: node di kanan, ganjil: node di kiri
        const UnitIcon = ICONS[u.ikon as IconName];
        const nomor = String(i + 1).padStart(2, '0');
        return (
          <li data-ad-step data-flip={flip ? '' : undefined} data-center={center ? '' : undefined}>
            <div
              class:list={[
                'md:sticky md:top-[max(6rem,calc(50svh-14rem))]',
                center ? 'flex flex-col items-center gap-6' : 'grid md:grid-cols-2 gap-6 md:gap-10 items-center',
              ]}
            >
              <!-- Penanda step di sisi kosong (bergeser menempel node saat node mengecil); unit tengah: di atas node -->
              <div
                data-ad-copy
                aria-hidden="true"
                class:list={[
                  'hidden md:flex flex-col gap-1 will-change-transform select-none',
                  center ? 'items-center text-center' : flip ? 'md:order-2 items-start text-left' : 'items-end text-right',
                ]}
              >
                <span class="font-serif font-extrabold text-7xl lg:text-8xl leading-none text-transparent [-webkit-text-stroke:1.5px_rgba(234,88,12,0.35)]">{nomor}</span>
                <span class="text-[11px] font-mono font-bold tracking-[0.3em] uppercase text-neutral-400">{tipeLabel(u)} · {u.kode}</span>
              </div>

              <!-- NODE -->
              <div
                data-ad-film
                class:list={[
                  'space-y-4 will-change-transform',
                  center ? 'w-full max-w-4xl md:origin-top' : flip ? 'md:origin-left' : 'md:origin-right',
                ]}
              >
                <!-- Kartu unit -->
                <article class="relative bg-white rounded-2xl border border-zinc-200/90 shadow-sm p-6 sm:p-7">
                  <span class="absolute top-5 right-5 text-[10px] font-mono font-bold px-2 py-0.5 rounded-md bg-orange-50 text-orange-700 border border-orange-200">{u.kode}</span>
                  <div class="flex items-start gap-4 pr-16">
                    <span class="w-11 h-11 shrink-0 rounded-xl bg-orange-50 border border-orange-200/70 text-sunset-orange flex items-center justify-center">
                      <UnitIcon className="w-5 h-5" strokeWidth={1.75} />
                    </span>
                    <div class="space-y-1">
                      <p data-ad-text class="text-[11px] font-mono font-bold tracking-widest uppercase text-orange-700">{u.label}</p>
                      <h3 data-ad-text class="text-xl sm:text-2xl font-serif font-extrabold tracking-tight text-neutral-950 leading-snug">{u.nama}</h3>
                    </div>
                  </div>
                  <div class="my-4 h-px bg-zinc-100"></div>
                  <p data-ad-text class="text-sm text-neutral-600 leading-relaxed">{u.deskripsi}</p>
                  <a
                    href={`/struktur-kabinet/${u.slug}`}
                    class="group mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-orange-700 hover:text-sunset-orange min-h-11 rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sunset-orange"
                  >
                    Lihat {tipeLabel(u)}
                    <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" strokeWidth={2} />
                  </a>
                </article>

                <!-- Kartu bidang / bagian -->
                <ul class:list={['grid gap-4', u.bidang.length > 2 ? 'grid-cols-2' : 'sm:grid-cols-2', center && u.bidang.length > 2 && 'lg:grid-cols-4']}>
                  {u.bidang.map((b) => {
                    const BIcon = ICONS[b.ikon as IconName];
                    return (
                      <li>
                        <a
                          href={`/struktur-kabinet/${u.slug}/${b.slug}`}
                          class="group flex flex-col gap-1.5 h-full bg-white rounded-2xl border border-zinc-200/90 shadow-sm p-4 hover:border-sunset-orange/40 hover:shadow-md transition-[border-color,box-shadow] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sunset-orange"
                        >
                          <span class="flex items-start gap-2 font-bold text-sm text-neutral-900 leading-snug">
                            <BIcon className="w-4 h-4 mt-0.5 shrink-0 text-sunset-orange" strokeWidth={1.75} />
                            {b.nama}
                          </span>
                          <span class="text-xs text-neutral-600 leading-relaxed line-clamp-3">{b.ringkas}</span>
                          <span class="mt-auto pt-1 inline-flex items-center gap-1 text-[11px] font-bold text-orange-700">
                            Lihat struktur <ArrowRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
            <!-- Spacer: lama node "tertahan" saat sticky -->
            <div aria-hidden="true" class="hidden md:block h-[60svh]"></div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  /** Skala terkecil node saat masuk/keluar. */
  const MIN_SCALE = 0.75;

  let ctx: gsap.Context | null = null;
  let mm: gsap.MatchMedia | null = null;

  function initArsitektur() {
    const root = document.getElementById('arsitektur-steps');
    if (!root) return;
    const section = root.closest('section') as HTMLElement;

    ctx?.revert();
    mm?.revert();

    // 4. Reveal teks per baris
    ctx = gsap.context(() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      section.querySelectorAll<HTMLElement>('[data-ad-text]').forEach((el) => {
        SplitText.create(el, {
          type: 'lines',
          mask: 'lines',
          autoSplit: true,
          onSplit: (self) =>
            gsap.from(self.lines, {
              yPercent: 135,
              duration: 0.8,
              ease: 'power3.out',
              stagger: 0.06,
              scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none reverse' },
            }),
        });
      });
    }, section);

    // 1–3. Sticky + scale + garis (desktop)
    mm = gsap.matchMedia();
    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      const svg = root.querySelector<SVGSVGElement>('[data-ad-links]');
      const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-ad-film]'));
      const links = Array.from(root.querySelectorAll<SVGPathElement>('[data-ad-link]'));
      const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-ad-step]'));
      let raf = 0;

      // Batch Read & Write untuk memusnahkan Layout Thrashing
      const drawLinks = () => {
        raf = 0;
        if (!svg) return;
        const box = svg.getBoundingClientRect();

        // 1. READ PHASE: Kumpulkan seluruh bounding box tanpa menyentuh DOM write
        const linkData = links.map((path, i) => {
          const center = steps[i + 1]?.hasAttribute('data-center');
          const a = nodes[i]?.getBoundingClientRect();
          const b = (center ? steps[i + 1].querySelector('[data-ad-copy]') : nodes[i + 1])?.getBoundingClientRect();
          if (!a || !b) return null;

          const x1 = (i % 2 ? a.right : a.left) - box.left;
          const y1 = a.bottom - box.top;
          const x2 = (center ? (b.left + b.right) / 2 : i % 2 ? b.left : b.right) - box.left;
          const y2 = b.top - box.top;
          const c = Math.max(40, (y2 - y1) * 0.8);

          return {
            path,
            d: `M${x1.toFixed(1)} ${y1.toFixed(1)} C${x1.toFixed(1)} ${(y1 + c).toFixed(1)} ${x2.toFixed(1)} ${(y2 - c).toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`
          };
        });

        // 2. WRITE PHASE: Update atribut SVG bersamaan
        linkData.forEach((item) => {
          if (item) item.path.setAttribute('d', item.d);
        });
      };

      const queueDraw = () => {
        if (!raf) raf = requestAnimationFrame(drawLinks);
      };

      // Garis tergambar saat node berikutnya masuk layar
      links.forEach((path, i) => {
        path.style.strokeDashoffset = '1';
        ScrollTrigger.create({
          trigger: steps[i + 1] ?? path,
          start: 'top bottom',
          end: 'top 40%',
          scrub: 0.5,
          onUpdate: (st) => {
            path.style.strokeDashoffset = String(1 - st.progress);
            queueDraw();
          },
        });
      });

      // Node membesar → tahan → mengecil; penanda step bergeser menempel node
      steps.forEach((step) => {
        const node = step.querySelector<HTMLElement>('[data-ad-film]');
        const copy = step.querySelector<HTMLElement>('[data-ad-copy]');
        if (!node || !copy) return;

        const dir = step.hasAttribute('data-center') ? 0 : step.hasAttribute('data-flip') ? -1 : 1;
        const state = { s: MIN_SCALE };

        const apply = () => {
          gsap.set(node, { scale: state.s });
          gsap.set(copy, { x: dir * (1 - state.s) * node.offsetWidth });
          queueDraw();
        };

        apply();

        gsap.timeline({
          scrollTrigger: { trigger: step, start: 'top 90%', end: 'bottom 10%', scrub: 0.5 },
          onUpdate: apply,
        })
          .to(state, { s: 1, ease: 'power2.inOut', duration: 1 })
          .to(state, { s: 1, duration: 0.9 })
          .to(state, { s: MIN_SCALE, ease: 'power2.inOut', duration: 1 });
      });

      // Sinkronisasi rAF ke ScrollTrigger & event scroll agar garis tidak ketinggalan saat sticky
      ScrollTrigger.addEventListener('refresh', queueDraw);
      window.addEventListener('scroll', queueDraw, { passive: true });

      queueDraw();

      return () => {
        cancelAnimationFrame(raf);
        ScrollTrigger.removeEventListener('refresh', queueDraw);
        window.removeEventListener('scroll', queueDraw);
        links.forEach((p) => p.removeAttribute('d'));
      };
    });
  }

  document.addEventListener('DOMContentLoaded', initArsitektur);
  document.addEventListener('astro:page-load', initArsitektur);
</script>