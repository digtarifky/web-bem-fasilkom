---
// src/components/struktur/PersonCard.astro
// Satu desain kartu foto untuk semua jabatan (kartu putih → foto 4:5 → kotak info), font Helvetica.
// Kotak info: nama lengkap, jabatan, dan prodi'angkatan (mis. "SI '24").
//
// Varian hanya membedakan aksen bingkai:
//   featured       → bingkai oranye (Ketum, Kepala)
//   featured-gold  → bingkai emas (Waketum)
//   standard/staff → bingkai netral
// Semua kartu sama ukuran: lebar diatur pemanggil (lihat CARD_W), tinggi menyamakan baris (flex stretch).
// Props `code`, `nomor`, `staffLabel` masih diterima agar pemanggil lama tetap kompatibel,
// tetapi tidak ditampilkan di desain ini.
import PersonPhoto from './PersonPhoto.astro';
import { labelAngkatan, type Person } from '../../data/struktur';

interface Props {
  person: Person;
  variant: 'featured' | 'featured-gold' | 'standard' | 'staff';
  /** Teks jabatan di kotak info. Default: jabatan dalam huruf besar. */
  badge?: string;
  /** Pill di atas kartu, mis. "Kepala Bidang" */
  topLabel?: string;
  /** @deprecated tidak ditampilkan */
  code?: string;
  /** @deprecated tidak ditampilkan */
  nomor?: string;
  /** @deprecated tidak ditampilkan */
  staffLabel?: string;
  /** @deprecated efek zoom kini aktif di semua kartu */
  zoom?: boolean;
  class?: string;
}

const { person, variant, badge = person.jabatan.toUpperCase(), topLabel, class: className = '' } = Astro.props;

const angkatan = labelAngkatan(person);

// Efek hover sama untuk semua kartu (pola kartu Ketum/Waketum):
// seluruh kartu (termasuk pill topLabel) naik + membesar 1.05, bingkai & bayangan bercahaya.
// Waketum memakai cahaya emas, kartu lain cahaya oranye. Zoom mati jika prefers-reduced-motion.
const GLOW_ORANGE = 'group-hover:shadow-[0_25px_50px_-12px_rgba(234,88,12,0.35)]';
const GLOW_GOLD = 'group-hover:shadow-[0_25px_50px_-12px_rgba(245,158,11,0.35)]';
const ACCENT = {
  featured: `border-sunset-orange/70 ${GLOW_ORANGE}`,
  'featured-gold': `border-warm-gold/80 ${GLOW_GOLD}`,
  standard: `border-zinc-200/90 group-hover:border-sunset-orange/70 ${GLOW_ORANGE}`,
  staff: `border-zinc-200/90 group-hover:border-sunset-orange/70 ${GLOW_ORANGE}`,
}[variant];

// Easing "ease-out-expo": cepat di awal, melambat halus di akhir. Kartu yang membesar naik di atas tetangganya.
const SMOOTH = 'duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]';
---

<article
  class:list={[
    'person-card group relative font-helvetica flex flex-col hover:z-10 hover:-translate-y-1.5 motion-safe:hover:scale-105',
    `transition-[scale,translate] ${SMOOTH}`,
    className,
  ]}
>
  {topLabel && (
    <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 whitespace-nowrap px-3 py-1 rounded-full bg-linear-to-r from-sunset-orange to-amber-500 text-white text-[10px] font-bold uppercase tracking-wider shadow-lg">
      {topLabel}
    </span>
  )}

  <div class:list={['flex-1 flex flex-col bg-white rounded-2xl border-2 shadow-sm p-2.5 sm:p-3', `transition-[box-shadow,border-color] ${SMOOTH}`, ACCENT]}>
    <PersonPhoto person={person} class="rounded-xl" />

    <div class="mt-2.5 sm:mt-3 flex-1 flex flex-col justify-center rounded-xl bg-neutral-50 border border-neutral-200/80 px-2 py-3 sm:py-3.5 text-center">
      <h3 class="font-bold text-sm sm:text-base lg:text-lg text-neutral-900 leading-snug">{person.nama}</h3>
      <p class="mt-1 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-orange-700 leading-snug">{badge}</p>
      <p class="mt-0.5 text-[10px] sm:text-[11px] font-bold tracking-wider text-orange-700">{angkatan}</p>
    </div>
  </div>
</article>
