---
// src/components/struktur/VisiMisi.astro
import { visi, misi } from '../../data/struktur';

const kartu =
  'bg-white rounded-2xl border border-zinc-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 p-8 sm:p-10 flex flex-col';
---

<div data-reveal-group class="grid md:grid-cols-2 gap-6">
  <!-- VISI -->
  <article class:list={['visimisi-card', kartu]}>
    <p class="text-xs font-extrabold tracking-widest text-orange-700 uppercase">Cita Luhur &amp; Cakrawala Strategis</p>
    <div class="mt-3 w-12 h-1 rounded-full bg-linear-to-r from-sunset-orange to-warm-gold" aria-hidden="true"></div>
    <h3 class="mt-6 font-serif font-extrabold text-3xl text-neutral-900 tracking-tight">Visi Kabinet</h3>

    <figure class="mt-6">
      <span class="block font-serif text-6xl leading-none h-8 text-sunset-orange/30 select-none" aria-hidden="true">&ldquo;</span>
      <blockquote class="text-lg sm:text-xl text-neutral-700 leading-relaxed">
        {visi}
      </blockquote>
    </figure>

    <div class="mt-auto pt-8">
      <div class="pt-5 border-t border-zinc-100 flex items-center justify-between gap-4 text-[10px] font-mono font-bold tracking-wider">
        <span class="text-neutral-400">PILAR FUNDAMENTAL</span>
        <span class="text-orange-700">AETHERION MANIFESTO</span>
      </div>
    </div>
  </article>

  <!-- MISI -->
  <article class:list={['visimisi-card', kartu]}>
    <p class="text-xs font-extrabold tracking-widest text-orange-700 uppercase">Rencana Aksi &amp; Transformasi</p>
    <div class="mt-3 w-12 h-1 rounded-full bg-linear-to-r from-sunset-orange to-warm-gold" aria-hidden="true"></div>
    <h3 class="mt-6 font-serif font-extrabold text-3xl text-neutral-900 tracking-tight">Misi Kabinet</h3>

    <ol class="mt-6 space-y-5">
      {misi.map((butir, i) => (
        <li class="flex gap-4">
          <span class="shrink-0 w-7 pt-0.5 font-mono font-bold text-sm text-orange-700" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">{butir}</p>
        </li>
      ))}
    </ol>

    <div class="mt-auto pt-8">
      <div class="pt-5 border-t border-zinc-100 flex items-center justify-between gap-4 text-[10px] font-mono font-bold tracking-wider">
        <span class="text-neutral-400">PILAR FUNDAMENTAL</span>
        <span class="text-orange-700">AETHERION MANIFESTO</span>
      </div>
    </div>
  </article>
</div>
