---
// src/pages/berita/index.astro
// Halaman Utama Berita Acara & Publikasi Warta BEM FASILKOM 2026 (Kabinet Aetherion).
// Dilengkapi:
// 1. Padding atas luas agar judul tidak tertutup floating navbar.
// 2. Auto-Slide Carousel 3 Detik.
// 3. Page slide indicator (dots/pill) di posisi TENGAH BAWAH.
// 4. Tombol panah geser kanan-kiri mode HOVER ONLY (muncul saat cursor diarahkan).
// 5. Margin aman agar tombol geser TIDAK MENUTUPI judul maupun deskripsi.
// 6. Sinkronisasi real-time untuk warta yang diunggah dari /web-berita.
import PageLayout from '../../layouts/PageLayout.astro';
import { fetchArticles, formatTanggalIndonesia, type Article } from '../../data/berita';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000/api';
const articles: Article[] = await fetchArticles(apiUrl);

// Cari artikel-artikel untuk Hero Auto-Slide Carousel (minimal 3-4 artikel)
let heroSlides = articles.filter((a) => a.is_featured);
if (heroSlides.length < 3) {
  heroSlides = articles.slice(0, 4);
}

// Hitung kategori dan jumlahnya secara dinamis
const categoryCounts: Record<string, number> = {};
articles.forEach((a) => {
  const cat = a.category;
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
const categories = Object.keys(categoryCounts);
---

<PageLayout 
  title="Berita Acara — BEM FASILKOM UPN Veteran Jawa Timur 2026"
  description="Kumpulan berita, laporan khusus, rilis kegiatan, dan arsip publikasi resmi BEM FASILKOM 2026 Kabinet Aetherion."
>
  <!-- Main Container: pt-40 sm:pt-44 lg:pt-48 memastikan judul bebas dari halangan floating navbar -->
  <div class="pt-40 sm:pt-44 lg:pt-48 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- ================= 1. HEADER SECTION ================= -->
    <header class="space-y-2">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-neutral-900 tracking-tight leading-none">
        Berita Acara
        <span class="block text-sunset-orange italic font-normal text-3xl sm:text-4xl lg:text-5xl mt-2">
          BEM FASILKOM
        </span>
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 font-sans max-w-2xl pt-2">
        Dokumentasi komprehensif dinamika pergerakan, advokasi, riset teknologi, dan harmonisasi civitas akademika Fakultas Ilmu Komputer.
      </p>
    </header>

    <!-- ================= 2. HERO AUTO-SLIDE CAROUSEL (3 DETIK) ================= -->
    <section aria-label="Berita Utama Terkini" class="relative group/carousel">
      <div 
        id="hero-carousel-container" 
        class="relative rounded-3xl sm:rounded-4xl overflow-hidden shadow-xl border border-neutral-200/80 bg-neutral-950 aspect-[16/10] sm:aspect-[21/9]"
      >
        <!-- Slides List -->
        <div id="carousel-slides" class="relative w-full h-full">
          {heroSlides.map((slide, index) => (
            <div
              data-slide-index={index}
              class={`carousel-slide absolute inset-0 w-full h-full transition-all duration-700 ease-in-out ${index === 0 ? 'opacity-100 scale-100 z-10 pointer-events-auto' : 'opacity-0 scale-98 z-0 pointer-events-none'}`}
            >
              <!-- Slide Background Image -->
              <img
                src={slide.image_url || '/assets/foto-kabinet/bph/RELEASE FUNGSIONARIS.webp'}
                alt={slide.title}
                class="absolute inset-0 w-full h-full object-cover object-center"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />

              <!-- Gradient Overlay Dramatis -->
              <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/55 via-55% to-black/25"></div>
              <div class="absolute inset-0 bg-linear-to-r from-black/80 via-black/25 to-transparent"></div>

              <!-- Konten Teks di Atas Overlay:
                   Padding horizontal px-8 sm:px-20 lg:px-24 memberi jarak aman yang luas 
                   sehingga judul & deskripsi TIDAK AKAN PERNAH tertutupi tombol panah kanan-kiri.
                   Padding bawah pb-14 sm:pb-16 memberi ruang bebas untuk pagination dots di tengah. -->
              <a 
                href={`/berita/${slide.slug}`}
                class="absolute inset-0 px-8 sm:px-20 lg:px-24 pb-14 sm:pb-16 pt-8 z-10 flex flex-col justify-end space-y-2.5 sm:space-y-4 max-w-4xl group/link"
              >
                <!-- Badge Kategori & Tanggal -->
                <div class="flex items-center gap-2.5 flex-wrap">
                  <span class="px-3.5 py-1 rounded-full bg-sunset-orange text-white text-[10px] sm:text-[11px] font-mono font-bold tracking-wider uppercase shadow-xs">
                    {slide.sub_category || slide.category}
                  </span>
                  <span class="text-xs font-mono text-neutral-300">
                    {formatTanggalIndonesia(slide.published_at)}
                  </span>
                </div>

                <!-- Judul Utama (Bebas Halangan) -->
                <h2 class="text-lg sm:text-2xl lg:text-4xl font-serif font-extrabold text-white tracking-tight leading-snug sm:leading-tight group-hover/link:text-amber-200 transition-colors">
                  {slide.title}
                </h2>

                <!-- Excerpt Deskripsi (Bebas Halangan) -->
                <p class="text-xs sm:text-sm lg:text-base text-neutral-300 font-sans line-clamp-2 leading-relaxed max-w-3xl">
                  {slide.excerpt}
                </p>
              </a>
            </div>
          ))}
        </div>

        <!-- Tombol Panah Kiri:
             - Mode Hover Saja (opacity-0, muncul saat cursor masuk banner: group-hover/carousel:opacity-100)
             - Transisi halus slide-in dari kiri (-translate-x-3 -> translate-x-0)
             - Diletakkan di samping kiri tanpa menabrak teks -->
        <button
          type="button"
          id="carousel-prev-btn"
          aria-label="Slide Sebelumnya"
          class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/45 hover:bg-sunset-orange backdrop-blur-md border border-white/30 flex items-center justify-center text-white transition-all duration-300 cursor-pointer shadow-xl active:scale-95 opacity-0 -translate-x-3 group-hover/carousel:opacity-100 group-hover/carousel:translate-x-0 pointer-events-none group-hover/carousel:pointer-events-auto"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6 -translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <!-- Tombol Panah Kanan:
             - Mode Hover Saja (opacity-0, muncul saat cursor masuk banner: group-hover/carousel:opacity-100)
             - Transisi halus slide-in dari kanan (translate-x-3 -> translate-x-0)
             - Diletakkan di samping kanan tanpa menabrak teks -->
        <button
          type="button"
          id="carousel-next-btn"
          aria-label="Slide Berikutnya"
          class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black/45 hover:bg-sunset-orange backdrop-blur-md border border-white/30 flex items-center justify-center text-white transition-all duration-300 cursor-pointer shadow-xl active:scale-95 opacity-0 translate-x-3 group-hover/carousel:opacity-100 group-hover/carousel:translate-x-0 pointer-events-none group-hover/carousel:pointer-events-auto"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <!-- Indikator Pagination Pill:
             Ditempatkan PERSIS DI TENGAH BAWAH (left-1/2 -translate-x-1/2) -->
        <div class="absolute bottom-4 sm:bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 p-1.5 rounded-full bg-black/50 backdrop-blur-md border border-white/20 shadow-md">
          {heroSlides.map((_, i) => (
            <button
              type="button"
              data-dot-index={i}
              class={`carousel-dot transition-all duration-300 rounded-full h-1.5 cursor-pointer ${i === 0 ? 'w-6 bg-sunset-orange' : 'w-2 bg-white/40 hover:bg-white/80'}`}
              aria-label={`Ke slide ${i + 1}`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 3. ARSIP WARTA & FILTER TABS ================= -->
    <section class="space-y-8 pt-4">
      
      <!-- Sub-header & Tabs Bar -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-neutral-200 pb-6">
        
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-xs font-mono font-bold tracking-wider text-sunset-orange uppercase">
            <span class="w-2.5 h-2.5 bg-sunset-orange rounded-xs inline-block"></span>
            Arsip Warta Terkini
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-extrabold text-neutral-900 tracking-tight">
            Indeks Publikasi Artikel
          </h2>
        </div>

        <!-- Filter Tabs Interaktif -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full no-scrollbar" id="category-tabs">
          <!-- Tab Semua -->
          <button
            type="button"
            data-category="all"
            class="category-tab px-4 py-2 rounded-full text-xs font-mono font-bold tracking-wider transition-all whitespace-nowrap cursor-pointer bg-sunset-orange text-white shadow-xs"
          >
            Semua ({articles.length})
          </button>

          <!-- Tab Per Kategori Dinamis -->
          {categories.map((cat) => (
            <button
              type="button"
              data-category={cat.toLowerCase()}
              class="category-tab px-4 py-2 rounded-full text-xs font-mono font-bold tracking-wider transition-all whitespace-nowrap cursor-pointer bg-white text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 border border-neutral-200"
            >
              {cat} ({categoryCounts[cat]})
            </button>
          ))}
        </div>

      </div>

      <!-- ================= 4. ARTICLE GRID (3 COLUMNS) ================= -->
      <div 
        id="articles-grid" 
        data-api-url={apiUrl}
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        {articles.map((article) => (
          <article 
            data-article-item
            data-category={article.category.toLowerCase()}
            class="news-card article-card group bg-white rounded-2xl sm:rounded-3xl border border-neutral-200/80 shadow-xs flex flex-col overflow-hidden transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(255,107,0,0.12)] hover:border-sunset-orange/50"
          >
            <!-- Card Image Container (rounded-xl & aspect 16/10) -->
            <a 
              href={`/berita/${article.slug}`}
              class="relative aspect-[16/10] overflow-hidden rounded-xl bg-neutral-100 block m-3 sm:m-4 mb-0"
              aria-label={article.title}
            >
              <img
                src={article.image_url || '/assets/foto-kabinet/bph/RELEASE FUNGSIONARIS.webp'}
                alt={article.title}
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-108"
                loading="lazy"
                decoding="async"
              />

              <!-- Gradient Subtil Atas & Bawah -->
              <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

              <!-- Category Badge (Kiri Atas) -->
              <span class="absolute top-3 left-3 px-3 py-1 rounded-md bg-sunset-orange text-white text-[10px] font-mono font-bold tracking-widest uppercase shadow-sm">
                {article.category}
              </span>

              <!-- Date Badge (Kanan Bawah) -->
              <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-md bg-neutral-950/75 backdrop-blur-xs text-neutral-200 text-[11px] font-mono tracking-tight shadow-xs">
                {formatTanggalIndonesia(article.published_at)}
              </span>
            </a>

            <!-- Card Body -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <a href={`/berita/${article.slug}`} class="block">
                  <h3 class="font-serif font-bold text-lg sm:text-xl text-neutral-900 group-hover:text-sunset-orange transition-colors leading-snug line-clamp-2">
                    {article.title}
                  </h3>
                </a>
                <p class="text-xs sm:text-sm text-neutral-600 font-sans leading-relaxed line-clamp-2">
                  {article.excerpt}
                </p>
              </div>

              <!-- Card Footer -->
              <div class="pt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-mono">
                <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider truncate max-w-[150px]">
                  {article.sub_category || 'BERITA ACARA'}
                </span>
                <a 
                  href={`/berita/${article.slug}`}
                  class="font-bold text-sunset-orange hover:text-amber-600 transition-colors inline-flex items-center gap-1 group-hover:translate-x-1 duration-200 shrink-0"
                >
                  Baca Telusur <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- State Kosong jika filter tidak menemukan artikel -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-neutral-200/80 space-y-3">
        <p class="font-serif text-lg font-bold text-neutral-800">Tidak ada artikel dalam kategori ini</p>
        <p class="text-xs font-mono text-neutral-500">Silakan pilih kategori lain atau kembali ke filter "Semua".</p>
      </div>

    </section>

  </div>
</PageLayout>

<script>
  import gsap from 'gsap';

  let autoSlideInterval: ReturnType<typeof setInterval> | null = null;

  function stopAutoSlide() {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval);
      autoSlideInterval = null;
    }
  }

  function initNewsPage() {
    const grid = document.getElementById('articles-grid');
    if (!grid) return;

    // ================= 1. GSAP ENTRANCE STAGGER ANIMATION =================
    const cards = document.querySelectorAll('.news-card');
    if (cards.length > 0) {
      gsap.fromTo(
        cards,
        { y: 45, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          stagger: 0.1,
          duration: 0.85,
          ease: 'power2.out',
          clearProps: 'transform,opacity',
        }
      );
    }

    // ================= 2. AUTO-SLIDE HERO CAROUSEL (3 DETIK) =================
    const slides = document.querySelectorAll<HTMLElement>('.carousel-slide');
    const dots = document.querySelectorAll<HTMLElement>('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');
    const carouselContainer = document.getElementById('hero-carousel-container');

    let currentSlide = 0;
    const totalSlides = slides.length;

    stopAutoSlide();

    function goToSlide(index: number) {
      if (totalSlides <= 1) return;

      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('opacity-0', 'scale-98', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'z-10');
          slide.classList.add('opacity-0', 'scale-98', 'pointer-events-none', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.className = 'carousel-dot transition-all duration-300 rounded-full h-1.5 cursor-pointer w-6 bg-sunset-orange';
        } else {
          dot.className = 'carousel-dot transition-all duration-300 rounded-full h-1.5 cursor-pointer w-2 bg-white/40 hover:bg-white/80';
        }
      });

      currentSlide = index;
    }

    function nextSlide() {
      goToSlide((currentSlide + 1) % totalSlides);
    }

    function prevSlide() {
      goToSlide((currentSlide - 1 + totalSlides) % totalSlides);
    }

    function startAutoSlide() {
      if (totalSlides > 1) {
        stopAutoSlide();
        autoSlideInterval = setInterval(nextSlide, 3000); // Tepat 3 detik sekali
      }
    }

    if (nextBtn) {
      nextBtn.onclick = (e) => {
        e.preventDefault();
        nextSlide();
        startAutoSlide();
      };
    }

    if (prevBtn) {
      prevBtn.onclick = (e) => {
        e.preventDefault();
        prevSlide();
        startAutoSlide();
      };
    }

    dots.forEach((dot) => {
      dot.onclick = (e) => {
        e.preventDefault();
        const targetIndex = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        goToSlide(targetIndex);
        startAutoSlide();
      };
    });

    if (carouselContainer) {
      carouselContainer.onmouseenter = stopAutoSlide;
      carouselContainer.onmouseleave = startAutoSlide;
    }

    startAutoSlide();

    // ================= 3. FILTER TABS KATEGORI =================
    const tabs = document.querySelectorAll<HTMLElement>('.category-tab');
    const articleCards = document.querySelectorAll<HTMLElement>('[data-article-item]');
    const emptyState = document.getElementById('empty-state');

    tabs.forEach((tab) => {
      tab.onclick = () => {
        const targetCategory = tab.dataset.category || 'all';

        // Update styling tab aktif
        tabs.forEach((t) => {
          t.className = 'category-tab px-4 py-2 rounded-full text-xs font-mono font-bold tracking-wider transition-all whitespace-nowrap cursor-pointer bg-white text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 border border-neutral-200';
        });
        tab.className = 'category-tab px-4 py-2 rounded-full text-xs font-mono font-bold tracking-wider transition-all whitespace-nowrap cursor-pointer bg-sunset-orange text-white shadow-xs';

        // Filter kartu dengan animasi stagger halus
        let visibleCount = 0;
        const visibleList: HTMLElement[] = [];
        articleCards.forEach((card) => {
          const cardCat = card.dataset.category || '';
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.classList.remove('hidden');
            visibleList.push(card);
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleList.length > 0) {
          gsap.fromTo(
            visibleList,
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, stagger: 0.05, duration: 0.45, ease: 'power2.out', clearProps: 'transform,opacity' }
          );
        }

        // Tampilkan/sembunyikan empty state
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      };
    });

    // ================= 4. SINKRONISASI API WAKTU NYATA =================
    const apiUrl = grid.dataset.apiUrl || import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000/api';
    async function syncLatestFromApi() {
      try {
        const res = await fetch(`${apiUrl}/articles`, { signal: AbortSignal.timeout(2000) });
        if (!res.ok) return;
        const json = await res.json();
        if (!json.data || !Array.isArray(json.data) || json.data.length === 0) return;

        const existingSlugs = new Set(
          Array.from(grid!.querySelectorAll('a[href^="/berita/"]')).map((a) => {
            const parts = a.getAttribute('href')!.split('/');
            return parts[parts.length - 1];
          })
        );

        const newArticles = json.data.filter((item: any) => !existingSlugs.has(item.slug));

        if (newArticles.length > 0) {
          const newElements: HTMLElement[] = [];
          newArticles.forEach((article: any) => {
            const articleEl = document.createElement('article');
            articleEl.setAttribute('data-article-item', '');
            articleEl.setAttribute('data-category', (article.category || '').toLowerCase());
            articleEl.className = 'news-card article-card group bg-white rounded-2xl sm:rounded-3xl border border-neutral-200/80 shadow-xs flex flex-col overflow-hidden transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(255,107,0,0.12)] hover:border-sunset-orange/50';
            
            const pubDate = article.published_at 
              ? new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
              : 'Baru Saja';

            articleEl.innerHTML = `
              <a href="/berita/${article.slug}" class="relative aspect-[16/10] overflow-hidden rounded-xl bg-neutral-100 block m-3 sm:m-4 mb-0" aria-label="${article.title}">
                <img src="${article.image_url || '/assets/foto-kabinet/bph/RELEASE FUNGSIONARIS.webp'}" alt="${article.title}" class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-108" loading="lazy" decoding="async" />
                <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>
                <span class="absolute top-3 left-3 px-3 py-1 rounded-md bg-sunset-orange text-white text-[10px] font-mono font-bold tracking-widest uppercase shadow-sm">${article.category}</span>
                <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-md bg-neutral-950/75 backdrop-blur-xs text-neutral-200 text-[11px] font-mono tracking-tight shadow-xs">${pubDate}</span>
              </a>
              <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <a href="/berita/${article.slug}" class="block">
                    <h3 class="font-serif font-bold text-lg sm:text-xl text-neutral-900 group-hover:text-sunset-orange transition-colors leading-snug line-clamp-2">${article.title}</h3>
                  </a>
                  <p class="text-xs sm:text-sm text-neutral-600 font-sans leading-relaxed line-clamp-2">${article.excerpt || ''}</p>
                </div>
                <div class="pt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-mono">
                  <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider truncate max-w-[150px]">${article.sub_category || 'BERITA ACARA'}</span>
                  <a href="/berita/${article.slug}" class="font-bold text-sunset-orange hover:text-amber-600 transition-colors inline-flex items-center gap-1 group-hover:translate-x-1 duration-200 shrink-0">
                    Baca Telusur <span>→</span>
                  </a>
                </div>
              </div>
            `;

            grid!.prepend(articleEl);
            newElements.push(articleEl);
          });

          if (newElements.length > 0) {
            gsap.fromTo(
              newElements,
              { y: 30, opacity: 0 },
              { y: 0, opacity: 1, stagger: 0.1, duration: 0.6, ease: 'power2.out', clearProps: 'transform,opacity' }
            );
          }
        }
      } catch (_e) {
        // Fallback hening jika API offline
      }
    }

    syncLatestFromApi();
  }

  document.addEventListener('astro:page-load', initNewsPage);
  document.addEventListener('astro:before-swap', stopAutoSlide);
</script>
