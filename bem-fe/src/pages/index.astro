---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SambutanSection from '../components/home/SambutanSection.astro';
import VideoSection from '../components/home/VideoSection.astro';

const marqueeItems = [
  { badge: '82 ANGGOTA' },
  { text: 'BEM FASILKOM UPNVJT' },
  { badge: '17 PROGRAM KERJA' },
  { text: 'KABINET AETHERION 2026' },
  { badge: '13 BIDANG & BAGIAN' },
  { text: 'Satu Fasilkom, Kita Kuat!"', isQuote: true },
];

const prokerList = [
  {
    image: '/assets/foto-proker/diesnatalis.png',
    badge: 'Rekor MURI',
    title: 'Dies Natalis Fasilkom',
    description: 'Perayaan hari lahir Fasilkom dengan agenda akbar pemecahan Rekor MURI melalui aksi pembuatan 1.000 website UMKM secara serentak.',
    category: 'Pengabdian & Event',
  },
  {
    image: '/assets/foto-proker/fkbmik.png',
    badge: 'Antar-UPN',
    title: 'FKBMIK',
    description: 'Forum Komunikasi BEM Ilmu Komputer sebagai wadah konsolidasi, sinergi, dan internalisasi strategis antar 3 kampus UPN "Veteran" di Indonesia.',
    category: 'Sinergi Nasional',
  },
  {
    image: '/assets/foto-proker/interaksi-2026.png',
    badge: 'Internal Ormawa',
    title: 'Interaksi 2026',
    description: 'Ruang internalisasi terpadu untuk merekatkan harmoni, koordinasi berkala, dan kolaborasi produktif antar seluruh Ormawa di lingkungan Fasilkom.',
    category: 'Harmonisasi Kampus',
  },
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/bem-fasilkom-logo.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>BEM FASILKOM UPNVJT 2026 | Kabinet Aetherion</title>
    <meta name="description" content="Badan Eksekutif Mahasiswa Fakultas Ilmu Komputer Universitas Pembangunan Nasional 'Veteran' Jawa Timur Periode 2026 - Kabinet Aetherion." />

    <!-- Google Fonts Preconnect & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&display=swap" rel="stylesheet" />

    <meta name="theme-color" content="#FAF9F6" />

    <!-- Intro hero: sembunyikan overlay, teks & navbar sebelum render pertama (sekali per sesi).
         Tanpa JS / reduced motion → kelas tidak dipasang, konten langsung tampil. -->
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('heroIntroSeen')) return;
          var html = document.documentElement;
          html.classList.add('hero-intro');
          // Pengaman: kalau script animasi gagal, konten tetap muncul
          setTimeout(function () { html.classList.remove('hero-intro'); }, 8000);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      html.hero-intro [data-intro-photo],
      html.hero-intro [data-intro-item],
      html.hero-intro body > header { opacity: 0; }
    </style>
  </head>
  <body class="bg-[#FAFAFA] text-zinc-900 antialiased selection:bg-orange-500 selection:text-white flex flex-col min-h-screen">
    
    <!-- Navbar Dinamis Independen -->
    <Navbar />

    <main class="grow">
      <!-- ========================================== -->
      <!-- 1. HERO SECTION                            -->
      <!-- ========================================== -->
      <section id="beranda" class="relative bg-aetherion-light text-neutral-900 pt-28 sm:pt-36 pb-20 sm:pb-28 overflow-hidden">
        <!-- Foto latar: Release Fungsionaris -->
        <img
          data-intro-photo
          src="/assets/foto-kabinet/bph/RELEASE%20FUNGSIONARIS.webp"
          alt=""
          aria-hidden="true"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none will-change-transform brightness-50 contrast-90 saturate-105"
        />
        <!-- Tanpa overlay: foto tampil jelas penuh. Teks hero berwarna putih. -->

        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
          <div class="max-w-3xl">
            <!-- Pill Badge -->
            <div data-intro-item class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/90 border border-neutral-200/80 text-sunset-orange text-xs font-semibold tracking-wider uppercase mb-6 backdrop-blur-sm shadow-xs">
              <span class="w-2 h-2 rounded-full bg-sunset-orange animate-pulse"></span>
              <span class="text-neutral-900 font-bold">BEM FASILKOM UPNVJT</span>
              <span class="text-neutral-300">•</span>
              <span class="text-sunset-orange font-bold">KABINET AETHERION 2026</span>
            </div>

            <!-- Main Headline -->
            <h1 data-intro-item class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.12] ">
              <span class="text-white">Selamat datang di</span><br />
              <span class="text-transparent bg-clip-text bg-linear-to-r from-sunset-orange via-amber-500 to-sunset-orange">
                BEM FASILKOM
              </span>{" "}
              <span class="text-white">UPNVJT</span><br />
              <span class="text-white">2026</span>
            </h1>

            <!-- Subtitle Description -->
            <p data-intro-item class="text-white mt-6 text-sm sm:text-base md:text-lg leading-relaxed max-w-2xl font-semibold">
              Mewujudkan Badan Eksekutif Mahasiswa Fakultas Ilmu Komputer yang kreatif, adaptif, dan kolaboratif terhadap seluruh organisasi mahasiswa di UPN "Veteran" Jawa Timur yang berlandaskan Tri Dharma Perguruan Tinggi.
            </p>

            <!-- Action Buttons (CTA) -->
            <div data-intro-item class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
              <a
                href="#proker"
                class="px-6 py-3.5 rounded-xl bg-linear-to-r from-sunset-orange to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm tracking-wide shadow-lg shadow-sunset-orange/25 flex items-center gap-2.5 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] group"
              >
                <span>Lihat Program Kerja</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="#sambutan"
                class="px-6 py-3.5 rounded-xl bg-white hover:bg-neutral-50 text-neutral-800 border border-neutral-200/80 shadow-xs hover:shadow-md font-semibold text-sm tracking-wide flex items-center gap-2 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
              >
                <span>Tentang Kami</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- PEMBATAS PERGANTIAN WARNA: RUNNING TEXT LOOPING (MARQUEE) -->
      <!-- ======================================================== -->
      <div class="relative w-full overflow-hidden bg-linear-to-r from-sunset-orange via-amber-500 to-sunset-orange py-3.5 sm:py-4 border-y border-neutral-900/15 shadow-xl select-none z-20">
        <div class="animate-marquee-infinite">
          {[1, 2].map((_, trackIdx) => (
            <div class="flex items-center shrink-0" aria-hidden={trackIdx > 0}>
              <span class="inline-flex items-center gap-6 px-4 text-xs sm:text-sm md:text-base font-extrabold uppercase tracking-wider text-neutral-950 font-sans">
                {marqueeItems.map((item) => (
                  <>
                    {item.badge ? (
                      <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-neutral-950 text-amber-400 font-mono text-xs font-bold shadow-sm">
                        {item.badge}
                      </span>
                    ) : (
                      <span class:list={[item.isQuote && 'font-serif italic font-bold']}>
                        {item.text}
                      </span>
                    )}
                    <span class="text-neutral-950/40 text-lg">✦</span>
                  </>
                ))}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- ========================================== -->
      <!-- 2. SAMBUTAN KETUA & WAKIL KETUA (PINNED 3D) -->
      <!-- ========================================== -->
      <SambutanSection />

      <!-- ========================================== -->
      <!-- 3. VIDEO PROFIL & MISI STRATEGIS (3D CINEMA)-->
      <!-- ========================================== -->
      {/* <VideoSection /> */}

      <!-- ========================================== -->
      <!-- 4. PROGRAM KERJA UNGGULAN                  -->
      <!-- ========================================== -->
      <section id="proker" class="py-20 sm:py-28 bg-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
          
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div>
              <span class="text-xs font-extrabold tracking-widest text-orange-600 uppercase mb-2 block">
                INISIASI STRATEGIS
              </span>
              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-zinc-950 tracking-tight">
                Program Kerja Unggulan
              </h2>
              <p class="mt-2 text-zinc-600 text-sm sm:text-base">
                Rangkuman aksi nyata Kabinet Aetherion untuk memajukan potensi mahasiswa.
              </p>
            </div>

            <a 
              href="#" 
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-orange-600 hover:text-orange-700 group transition-colors shrink-0"
            >
              <span>Lihat Seluruh 42 Program Kerja</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <!-- 3 Cards Grid: Landscape 3 Kolom -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
            {prokerList.map((item) => (
              <div class="bg-white rounded-3xl border border-neutral-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 p-5 sm:p-6 flex flex-col justify-between group">
                <div class="grow flex flex-col">
                  <!-- Kontainer Gambar Landscape 16:10 -->
                  <div class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-5 bg-neutral-100 border border-neutral-200/80">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

                    <!-- Badge di Pojok Kiri Atas -->
                    {item.badge && (
                      <div class="absolute top-3 left-3 z-10">
                        <span class="inline-block px-3 py-1 rounded-full bg-neutral-900/85 backdrop-blur-md text-white text-[10px] font-mono font-bold tracking-wider uppercase border border-white/15 shadow-sm">
                          {item.badge}
                        </span>
                      </div>
                    )}
                  </div>

                  <h3 class="text-lg sm:text-xl font-bold text-zinc-950 group-hover:text-sunset-orange transition-colors leading-snug">
                    {item.title}
                  </h3>

                  <p class="mt-2 text-xs sm:text-sm text-zinc-600 leading-relaxed grow">
                    {item.description}
                  </p>
                </div>

                <div class="mt-5 pt-4 border-t border-zinc-100 flex items-center justify-between text-xs">
                  <span class="text-zinc-600 text-[11px] font-semibold">{item.category}</span>
                  <span class="text-sunset-orange font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    <span>Detail</span>
                    <span>&rarr;</span>
                  </span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>
    </main>

    <!-- Footer Editorial 3 Kolom -->
    <Footer />

    <!-- Modals Interaktif Langsung di Halaman Index -->
    <!-- Modal Video -->
    <div 
      id="video-modal" 
      class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <div class="relative w-full max-w-4xl bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl p-6 sm:p-8 text-center text-white">
        <button 
          id="close-modal-btn"
          type="button"
          class="absolute top-4 right-4 z-30 p-2 rounded-full bg-zinc-900/80 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors"
          aria-label="Tutup Video"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="w-14 h-14 mx-auto rounded-full bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 mb-4">
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-black mb-2">Company Profile Video 2026</h3>
        <p class="text-zinc-400 text-sm max-w-md mx-auto mb-6">
          Video resmi perkenalan Kabinet Aetherion BEM FASILKOM UPN "Veteran" Jawa Timur segera tayang serentak di kanal YouTube resmi.
        </p>
        <a 
          href="https://www.youtube.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold uppercase tracking-wider transition-colors"
        >
          <span>Kunjungi YouTube BEM FASILKOM</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Modal Filosofi Logo -->
    <div 
      id="filosofi-modal" 
      class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
    >
      <div class="relative w-full max-w-2xl bg-zinc-950 border border-zinc-800 rounded-3xl overflow-hidden shadow-2xl p-6 sm:p-8 text-white">
        <button 
          id="close-filosofi-btn" 
          class="absolute top-5 right-5 p-2 rounded-full bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors"
          aria-label="Tutup Modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-2xl bg-orange-500/10 border border-orange-500/30 p-2 flex items-center justify-center shrink-0">
            <img src="/assets/logo/bem-fasilkom-logo.svg" alt="Logo Aetherion" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-orange-500">Filosofi & Makna</span>
            <h3 class="text-xl sm:text-2xl font-black">Logo Kabinet Aetherion 2026</h3>
          </div>
        </div>

        <div class="space-y-4 text-xs sm:text-sm text-zinc-300 leading-relaxed border-t border-zinc-800/80 pt-5">
          <div class="flex items-start gap-3">
            <div class="w-2 h-2 rounded-full bg-orange-500 mt-1.5 shrink-0"></div>
            <p>
              <strong class="text-white">Cincin Orbit Melingkar:</strong> Melambangkan sinergi tanpa batas antarcivitas akademika dan tekad untuk terus berevolusi mengikuti percepatan teknologi dunia.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-2 h-2 rounded-full bg-amber-400 mt-1.5 shrink-0"></div>
            <p>
              <strong class="text-white">Inti Api Aetherion:</strong> Representasi karsa, keberanian berinovasi, serta daya juang mahasiswa Fakultas Ilmu Komputer yang senantiasa menyala untuk kebermanfaatan umat.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-2 h-2 rounded-full bg-yellow-400 mt-1.5 shrink-0"></div>
            <p>
              <strong class="text-white">Gradasi Oranye & Emas:</strong> Simbol optimisme, kehangatan kepemimpinan yang inklusif, dan dedikasi luhur bagi almamater UPN "Veteran" Jawa Timur.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-800/60 flex justify-end">
          <button 
            id="confirm-filosofi-btn"
            class="px-5 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold uppercase tracking-wider transition-colors"
          >
            Mengerti
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Aduan Center -->
    <div 
      id="aduan-modal" 
      class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
    >
      <div class="relative w-full max-w-xl bg-zinc-950 border border-zinc-800 rounded-3xl overflow-hidden shadow-2xl p-6 sm:p-8 text-white">
        <button 
          id="close-aduan-btn" 
          class="absolute top-5 right-5 p-2 rounded-full bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors"
          aria-label="Tutup Modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3.5 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <div class="inline-flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
              <span class="text-xs font-bold uppercase tracking-widest text-orange-500">Layanan Mahasiswa</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black">Aduan Center 24/7</h3>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-zinc-400 mb-6 leading-relaxed">
          Sampaikan aspirasi, kendala akademik, fasilitas, maupun advokasi kesejahteraan mahasiswa secara aman, rahasia, dan langsung ditindaklanjuti oleh Biro Advokasi BEM FASILKOM 2026.
        </p>

        <div class="space-y-3 mb-6">
          <a 
            href="https://wa.me/6282134567890?text=Halo%20BEM%20FASILKOM%202026,%20saya%20ingin%20menyampaikan%20aduan" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-zinc-900 hover:bg-zinc-800/80 border border-zinc-800 hover:border-orange-500/40 transition-all group"
          >
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-green-500/10 text-green-400 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover:text-orange-400 transition-colors">WhatsApp Hotline Advokasi</div>
                <div class="text-[11px] text-zinc-400">+62 821-3456-7890 (Respon Cepat)</div>
              </div>
            </div>
            <span class="text-zinc-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>

          <a 
            href="mailto:bem.fasilkom@upnjatim.ac.id?subject=Aspirasi%20Mahasiswa%20Fasilkom" 
            class="flex items-center justify-between p-3.5 rounded-xl bg-zinc-900 hover:bg-zinc-800/80 border border-zinc-800 hover:border-orange-500/40 transition-all group"
          >
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-orange-500/10 text-orange-400 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-bold text-white group-hover:text-orange-400 transition-colors">Surel Resmi Advokasi</div>
                <div class="text-[11px] text-zinc-400">bem.fasilkom@upnjatim.ac.id</div>
              </div>
            </div>
            <span class="text-zinc-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>
        </div>

        <div class="flex justify-end pt-2 border-t border-zinc-800/60">
          <button 
            id="confirm-aduan-btn"
            class="px-5 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-bold uppercase tracking-wider transition-colors"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <!-- Script Interaktivitas Halaman Index -->
    <script>
      function initIndexPage() {
        // Video Modal
        const playBtn = document.getElementById('video-play-btn') || document.getElementById('play-teaser-btn');
        const playerContainer = document.getElementById('video-card-frame') || document.getElementById('video-player-container');
        const videoModal = document.getElementById('video-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');

        const openVideo = () => {
          videoModal?.classList.remove('opacity-0', 'pointer-events-none');
          videoModal?.classList.add('opacity-100', 'pointer-events-auto');
        };

        const closeVideo = () => {
          videoModal?.classList.add('opacity-0', 'pointer-events-none');
          videoModal?.classList.remove('opacity-100', 'pointer-events-auto');
        };

        playBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          openVideo();
        });
        playerContainer?.addEventListener('click', openVideo);
        closeModalBtn?.addEventListener('click', closeVideo);
        videoModal?.addEventListener('click', (e) => {
          if (e.target === videoModal) closeVideo();
        });

        // Filosofi Modal
        const filosofiModal = document.getElementById('filosofi-modal');
        const closeFilosofiBtn = document.getElementById('close-filosofi-btn');
        const confirmFilosofiBtn = document.getElementById('confirm-filosofi-btn');
        const filosofiTriggers = document.querySelectorAll('a[href="#filosofi"]');

        const openFilosofi = (e?: Event) => {
          e?.preventDefault();
          filosofiModal?.classList.remove('opacity-0', 'pointer-events-none');
          filosofiModal?.classList.add('opacity-100', 'pointer-events-auto');
        };

        const closeFilosofi = () => {
          filosofiModal?.classList.add('opacity-0', 'pointer-events-none');
          filosofiModal?.classList.remove('opacity-100', 'pointer-events-auto');
        };

        filosofiTriggers.forEach((btn) => btn.addEventListener('click', openFilosofi));
        closeFilosofiBtn?.addEventListener('click', closeFilosofi);
        confirmFilosofiBtn?.addEventListener('click', closeFilosofi);
        filosofiModal?.addEventListener('click', (e) => {
          if (e.target === filosofiModal) closeFilosofi();
        });

        // Aduan Modal
        const aduanModal = document.getElementById('aduan-modal');
        const closeAduanBtn = document.getElementById('close-aduan-btn');
        const confirmAduanBtn = document.getElementById('confirm-aduan-btn');
        const aduanTriggers = document.querySelectorAll('a[href="#aduan"]');

        const openAduan = (e?: Event) => {
          e?.preventDefault();
          aduanModal?.classList.remove('opacity-0', 'pointer-events-none');
          aduanModal?.classList.add('opacity-100', 'pointer-events-auto');
        };

        const closeAduan = () => {
          aduanModal?.classList.add('opacity-0', 'pointer-events-none');
          aduanModal?.classList.remove('opacity-100', 'pointer-events-auto');
        };

        aduanTriggers.forEach((btn) => btn.addEventListener('click', openAduan));
        closeAduanBtn?.addEventListener('click', closeAduan);
        confirmAduanBtn?.addEventListener('click', closeAduan);
        aduanModal?.addEventListener('click', (e) => {
          if (e.target === aduanModal) closeAduan();
        });

        // Escape Key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeVideo();
            closeFilosofi();
            closeAduan();
          }
        });
      }

      document.addEventListener('DOMContentLoaded', initIndexPage);
      document.addEventListener('astro:page-load', initIndexPage);
    </script>

    <!-- Intro hero: foto full kabinet tampil jelas dulu (zoom-out pelan), lalu overlay, teks, dan navbar muncul -->
    <script>
      import gsap from 'gsap';

      let played = false;

      async function playHeroIntro() {
        const html = document.documentElement;
        if (played || !html.classList.contains('hero-intro')) return;
        const hero = document.getElementById('beranda');
        const photo = hero?.querySelector<HTMLImageElement>('[data-intro-photo]');
        if (!hero || !photo) { html.classList.remove('hero-intro'); return; }
        played = true;
        try { sessionStorage.setItem('heroIntroSeen', '1'); } catch {}

        const items = hero.querySelectorAll<HTMLElement>('[data-intro-item]');
        const navbar = document.querySelector<HTMLElement>('body > header');

        // Kunci state awal lewat inline style, lalu lepas kelas CSS penyembunyi
        gsap.set([...items, navbar].filter(Boolean), { opacity: 0 });
        gsap.set(photo, { opacity: 0, scale: 1.12 });
        html.classList.remove('hero-intro');

        // Tunggu foto siap (maks. 2.5 dtk) agar intro tidak memperlihatkan area kosong
        await Promise.race([
          photo.decode().catch(() => {}),
          new Promise((r) => setTimeout(r, 2500)),
        ]);

        gsap.timeline({ defaults: { ease: 'power3.out' } })
          // 1. Foto full kabinet: fade-in + zoom-out pelan, tanpa overlay
          .to(photo, { opacity: 1, duration: 0.9, ease: 'power1.out' }, 0)
          .to(photo, { scale: 1, duration: 2.6, ease: 'power2.out' }, 0)
          // 2. Setelah foto sempat dinikmati, teks & tombol naik berurutan
          .fromTo(items, { y: 28 }, { opacity: 1, y: 0, duration: 0.8, stagger: 0.12 }, 2.1)
          // 3. Navbar turun terakhir
          .fromTo(navbar, { y: -16 }, { opacity: 1, y: 0, duration: 0.6 }, 2.6)
          .eventCallback('onComplete', () => {
            gsap.set([photo, ...items, navbar].filter(Boolean), { clearProps: 'opacity,transform' });
          });
      }

      document.addEventListener('DOMContentLoaded', playHeroIntro);
      document.addEventListener('astro:page-load', playHeroIntro);
    </script>
  </body>
</html>
