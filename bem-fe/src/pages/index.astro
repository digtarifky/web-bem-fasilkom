---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';

const stats = [
  {
    value: '128',
    label: 'Orang',
    description: 'Total Anggota BEM',
    icon: 'users',
  },
  {
    value: '96',
    label: 'Staf Ahli',
    description: 'Total Fungsionaris',
    icon: 'shield',
  },
  {
    value: '42',
    label: 'Proker',
    description: 'Total Program Kerja',
    icon: 'clipboard',
  },
  {
    value: '10',
    label: 'Unit',
    description: '7 Bidang & 3 Biro',
    icon: 'layers',
  },
];

const prokerList = [
  {
    tag: 'SEMINAR',
    tagColor: 'bg-orange-600 text-white',
    title: 'Fasilkom Talk 2026',
    description: 'Seminar inspiratif menghadirkan alumni & pakar teknologi terdepan.',
    category: 'Akademik & Karir',
    gradient: 'from-orange-600/30 via-zinc-900 to-black',
    accentColor: '#EA580C',
  },
  {
    tag: 'HACKATHON',
    tagColor: 'bg-amber-500 text-zinc-950 font-black',
    title: 'Hackafest National',
    description: 'Kompetisi rekayasa perangkat lunak dan inovasi skala nasional.',
    category: 'Teknologi & Prestasi',
    gradient: 'from-amber-600/30 via-zinc-900 to-black',
    accentColor: '#F59E0B',
  },
  {
    tag: 'ADVOKASI',
    tagColor: 'bg-orange-600 text-white',
    title: 'Sambang Rasa',
    description: 'Ruang aspirasi berkala antara mahasiswa dengan pimpinan dekanat.',
    category: 'Kesejahteraan Mahasiswa',
    gradient: 'from-red-600/30 via-zinc-900 to-black',
    accentColor: '#DC2626',
  },
  {
    tag: 'BOOTCAMP',
    tagColor: 'bg-orange-500 text-white',
    title: 'DevCamp Academy',
    description: 'Pelatihan intensif pengembangan Web, AI, Cloud, dan Cyber Security.',
    category: 'Pengembangan Skill',
    gradient: 'from-yellow-600/30 via-zinc-900 to-black',
    accentColor: '#D97706',
  },
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/bem-fasilkom-logo.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>BEM FASILKOM UPNVJT 2026 | Kabinet Aetherion</title>
    <meta name="description" content="Badan Eksekutif Mahasiswa Fakultas Ilmu Komputer Universitas Pembangunan Nasional 'Veteran' Jawa Timur Periode 2026 - Kabinet Aetherion." />

    <!-- Google Fonts Preconnect & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&display=swap" rel="stylesheet" />

    <meta name="theme-color" content="#090A0F" />
  </head>
  <body class="bg-[#FAFAFA] text-zinc-900 antialiased selection:bg-orange-500 selection:text-white flex flex-col min-h-screen">
    
    <!-- Navbar Dinamis Independen -->
    <Navbar />

    <main class="flex-grow">
      <!-- ========================================== -->
      <!-- 1. HERO SECTION & STATS BAR                -->
      <!-- ========================================== -->
      <section id="beranda" class="relative bg-[#090A0F] text-white pt-28 sm:pt-36 pb-20 sm:pb-28 overflow-hidden">
        <!-- Dynamic Ambient Glows & Tech Grid Background -->
        <div class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:24px_24px] opacity-25"></div>
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-orange-600/20 via-amber-500/15 to-transparent blur-[120px] pointer-events-none rounded-full"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-orange-500/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
          <div class="max-w-3xl">
            <!-- Pill Badge -->
            <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-amber-950/40 border border-amber-500/30 text-amber-300 text-xs font-semibold tracking-wider uppercase mb-6 backdrop-blur-sm shadow-inner shadow-amber-500/10">
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span>BEM FASILKOM UPNVJT</span>
              <span class="text-amber-500/60">•</span>
              <span>KABINET AETHERION 2026</span>
            </div>

            <!-- Main Headline -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.12] text-white">
              Selamat datang di<br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-400 to-yellow-400">
                BEM FASILKOM
              </span>{" "}
              UPNVJT<br />
              2026
            </h1>

            <!-- Subtitle Description -->
            <p class="mt-6 text-zinc-400 text-sm sm:text-base md:text-lg leading-relaxed max-w-2xl font-normal">
              Mewujudkan Badan Eksekutif Mahasiswa Fakultas Ilmu Komputer yang kreatif, adaptif, dan kolaboratif terhadap seluruh organisasi mahasiswa di UPN "Veteran" Jawa Timur yang berlandaskan Tri Dharma Perguruan Tinggi.
            </p>

            <!-- Action Buttons (CTA) -->
            <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
              <a
                href="#proker"
                class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-orange-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-zinc-950 font-bold text-sm tracking-wide shadow-lg shadow-orange-500/25 flex items-center gap-2.5 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] group"
              >
                <span>Lihat Program Kerja</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="#sambutan"
                class="px-6 py-3.5 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 text-zinc-200 border border-zinc-700/60 font-semibold text-sm tracking-wide flex items-center gap-2 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
              >
                <span>Tentang Kami</span>
              </a>
            </div>
          </div>

          <!-- Stats Bar / Floating Grid Container -->
          <div class="mt-16 sm:mt-20 rounded-2xl bg-zinc-900/70 border border-zinc-800/90 backdrop-blur-md p-5 sm:p-7 shadow-2xl">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-4 divide-y md:divide-y-0 md:divide-x divide-zinc-800/80">
              {stats.map((item, idx) => (
                <div class:list={['flex items-center gap-4', idx > 0 ? 'pt-4 md:pt-0 md:pl-6' : '']}>
                  <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 flex-shrink-0 shadow-inner">
                    {item.icon === 'users' && (
                      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                      </svg>
                    )}
                    {item.icon === 'shield' && (
                      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                    )}
                    {item.icon === 'clipboard' && (
                      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                      </svg>
                    )}
                    {item.icon === 'layers' && (
                      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                      </svg>
                    )}
                  </div>
                  <div>
                    <div class="flex items-baseline">
                      <span class="text-2xl sm:text-3xl font-black text-white tracking-tight">{item.value}</span>
                      <span class="ml-1.5 text-xs sm:text-sm font-bold text-amber-400">{item.label}</span>
                    </div>
                    <p class="text-xs text-zinc-400 font-medium mt-0.5">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 2. SAMBUTAN PRESIDEN & WAPRES              -->
      <!-- ========================================== -->
      <section id="sambutan" class="py-20 sm:py-28 bg-[#FAFAFA] relative overflow-hidden border-b border-zinc-200/60">
        <!-- Subtle ambient decorative elements -->
        <div class="absolute top-10 right-10 w-72 h-72 bg-orange-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
            
            <!-- Left Column: 2 Tilted Overlapping Portrait Cards (5 cols) -->
            <div class="lg:col-span-5 relative flex justify-center py-6 sm:py-10">
              <div class="relative w-full max-w-[360px] sm:max-w-[400px] h-[440px] sm:h-[480px]">
                
                <!-- Card 1: Presiden BEM (Back/Left, Tilted -3deg) -->
                <div class="absolute top-0 left-2 sm:left-4 w-[240px] sm:w-[270px] h-[340px] sm:h-[380px] rounded-3xl bg-gradient-to-b from-zinc-800 to-zinc-950 p-2 shadow-2xl shadow-zinc-900/30 -rotate-3 hover:rotate-0 transition-all duration-300 z-10 border border-zinc-700/60 group">
                  <div class="w-full h-full rounded-2xl overflow-hidden relative bg-gradient-to-b from-zinc-700 via-zinc-800 to-zinc-950 flex flex-col justify-end p-4">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent z-10"></div>
                    
                    <!-- Stylized Silhouette / Executive Illustration -->
                    <div class="absolute inset-0 flex items-center justify-center opacity-85 group-hover:scale-105 transition-transform duration-500">
                      <svg viewBox="0 0 200 260" class="w-full h-full object-cover" fill="none">
                        <defs>
                          <linearGradient id="suitGradPres" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#3f3f46" />
                            <stop offset="100%" stop-color="#18181b" />
                          </linearGradient>
                          <linearGradient id="tieGradPres" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#f97316" />
                            <stop offset="100%" stop-color="#c2410c" />
                          </linearGradient>
                        </defs>
                        <path d="M20 260 L40 160 L75 140 L100 170 L125 140 L160 160 L180 260 Z" fill="url(#suitGradPres)" />
                        <polygon points="75,140 100,175 125,140 108,125 92,125" fill="#f4f4f5" />
                        <polygon points="96,145 104,145 106,195 100,205 94,195" fill="url(#tieGradPres)" />
                        <circle cx="100" cy="95" r="32" fill="#d4d4d8" />
                        <path d="M68 90 C68 62 82 50 100 50 C118 50 132 62 132 90 C125 76 112 70 100 70 C88 70 75 76 68 90 Z" fill="#27272a" />
                        <rect x="76" y="88" width="20" height="12" rx="3" stroke="#f97316" stroke-width="2" fill="none" opacity="0.9" />
                        <rect x="104" y="88" width="20" height="12" rx="3" stroke="#f97316" stroke-width="2" fill="none" opacity="0.9" />
                        <line x1="96" y1="94" x2="104" y2="94" stroke="#f97316" stroke-width="2" />
                      </svg>
                    </div>

                    <!-- Bottom Content Overlay -->
                    <div class="relative z-20">
                      <span class="inline-block px-2.5 py-0.5 rounded bg-orange-500 text-white font-black text-[9px] sm:text-[10px] tracking-wider uppercase shadow-sm">
                        PRESIDEN BEM
                      </span>
                      <h4 class="text-white font-bold text-sm sm:text-base leading-tight mt-1.5 drop-shadow-md">
                        Esko Pratama, S.Kom.
                      </h4>
                      <p class="text-zinc-300 text-xs font-medium mt-0.5">
                        Informatika '22
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Card 2: Wakil Presiden BEM (Front/Right, Tilted +4deg, Overlapping) -->
                <div class="absolute bottom-2 right-2 sm:right-4 w-[240px] sm:w-[270px] h-[340px] sm:h-[380px] rounded-3xl bg-gradient-to-b from-zinc-800 to-zinc-950 p-2 shadow-2xl shadow-zinc-900/40 rotate-4 hover:rotate-0 transition-all duration-300 z-20 border border-zinc-600/70 group">
                  <div class="w-full h-full rounded-2xl overflow-hidden relative bg-gradient-to-b from-zinc-700 via-zinc-800 to-zinc-950 flex flex-col justify-end p-4">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent z-10"></div>

                    <!-- Stylized Silhouette / Executive Illustration -->
                    <div class="absolute inset-0 flex items-center justify-center opacity-85 group-hover:scale-105 transition-transform duration-500">
                      <svg viewBox="0 0 200 260" class="w-full h-full object-cover" fill="none">
                        <defs>
                          <linearGradient id="suitGradWapres" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#27272a" />
                            <stop offset="100%" stop-color="#09090b" />
                          </linearGradient>
                          <linearGradient id="blazerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ea580c" />
                            <stop offset="100%" stop-color="#9a3412" />
                          </linearGradient>
                        </defs>
                        <path d="M25 260 L45 165 L80 145 L100 180 L120 145 L155 165 L175 260 Z" fill="url(#suitGradWapres)" />
                        <polygon points="80,145 100,185 120,145 108,130 92,130" fill="#fef08a" />
                        <polygon points="94,150 106,150 103,180 97,180" fill="url(#blazerGrad)" />
                        <circle cx="100" cy="95" r="30" fill="#e4e4e7" />
                        <path d="M68 95 C68 62 82 48 100 48 C118 48 132 62 132 95 C132 128 116 138 100 138 C84 138 68 128 68 95 Z" fill="#3f3f46" opacity="0.95" />
                        <circle cx="100" cy="94" r="22" fill="#f4f4f5" />
                      </svg>
                    </div>

                    <!-- Bottom Content Overlay -->
                    <div class="relative z-20">
                      <span class="inline-block px-2.5 py-0.5 rounded bg-amber-500 text-zinc-950 font-black text-[9px] sm:text-[10px] tracking-wider uppercase shadow-sm">
                        WAKIL PRESIDEN
                      </span>
                      <h4 class="text-white font-bold text-sm sm:text-base leading-tight mt-1.5 drop-shadow-md">
                        Julia Putri
                      </h4>
                      <p class="text-zinc-300 text-xs font-medium mt-0.5">
                        Sistem Informasi '22
                      </p>
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- Right Column: Editorial Message & Tagline (7 cols) -->
            <div class="lg:col-span-7 flex flex-col justify-center">
              <span class="text-xs font-extrabold tracking-widest text-orange-600 uppercase mb-2">
                BEM FASILKOM UPNVJT 2026
              </span>

              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-zinc-950 tracking-tight uppercase leading-tight">
                SAMBUTAN PRESIDEN & WAPRES
              </h2>

              <div class="mt-3 flex items-center gap-3">
                <span class="w-1 h-5 bg-orange-500 rounded-full"></span>
                <span class="text-sm font-semibold text-zinc-600 italic">
                  Nakhoda Kabinet Aetherion 2026
                </span>
              </div>

              <!-- Quote Block -->
              <div class="mt-6 relative">
                <span class="text-5xl font-serif text-orange-400/30 leading-none select-none absolute -top-4 -left-3">“</span>
                
                <div class="relative z-10 pl-4 space-y-4 text-zinc-700 text-sm sm:text-base leading-relaxed">
                  <p>
                    Selamat datang di gerbong pergerakan <strong class="text-zinc-950 font-bold">BEM FASILKOM 2026</strong>. Melalui <strong class="text-zinc-950 font-bold">Kabinet Aetherion</strong>, kami mendedikasikan seluruh daya kreasi dan komitmen untuk menghadirkan kepengurusan yang tidak hanya adaptif terhadap akselerasi teknologi, namun berakar kuat pada nilai kemanusiaan dan kemanfaatan nyata bagi civitas akademika.
                  </p>
                  <p>
                    Fakultas Ilmu Komputer adalah kawah candradimuka inovator muda. Bersama 10 bidang dan biro strategis, kami siap menjadi jembatan perubahan teknologi yang progresif, wadah riset kolaboratif, serta rumah yang ramah bagi seluruh aspirasi mahasiswa UPN "Veteran" Jawa Timur.
                  </p>
                </div>
              </div>

              <blockquote class="mt-6 pl-4 border-l-2 border-orange-400">
                <p class="text-base sm:text-lg font-bold italic text-zinc-900 tracking-tight">
                  "Menyulutkan Karsa, Merajut Inovasi Tanpa Batas"
                </p>
              </blockquote>

              <!-- Footer Meta Row -->
              <div class="mt-8 pt-5 border-t border-zinc-200/80 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-2 text-xs font-bold tracking-wider text-orange-600 uppercase">
                  <span>KABINET AETHERION</span>
                  <span class="text-zinc-400">•</span>
                  <span>BEM FASILKOM UPNVJT</span>
                </div>

                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-50 border border-orange-200/80 text-zinc-800 text-xs font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                  <span>Surabaya, 2026</span>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 3. VIDEO PROFIL & MISI STRATEGIS           -->
      <!-- (3 Kartu di bawahnya telah dihapus)        -->
      <!-- ========================================== -->
      <section id="profil-misi" class="py-20 sm:py-28 bg-[#F8F9FA] relative overflow-hidden border-b border-zinc-200/60">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
          
          <!-- Section Header (Centered) -->
          <div class="text-center max-w-2xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-950 text-white text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
              <span>TAYANGAN PERDANA KABINET AETHERION 2026</span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-zinc-950 tracking-tight leading-tight">
              Video Profil & <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500">Misi Strategis</span>
            </h2>

            <p class="mt-3 text-zinc-600 text-sm sm:text-base leading-relaxed">
              Kenali lebih dekat energi kabinet, nilai pergerakan, dan arah transformasi kami selama satu periode kepengurusan.
            </p>
          </div>

          <!-- Video Teaser Mockup Player -->
          <div class="mt-12 max-w-4xl mx-auto">
            <div 
              id="video-player-container"
              class="relative aspect-video rounded-2xl sm:rounded-3xl bg-zinc-950 border border-zinc-800 shadow-2xl shadow-zinc-950/20 overflow-hidden group cursor-pointer"
            >
              <div class="absolute inset-0 bg-gradient-to-tr from-black via-zinc-900 to-zinc-950"></div>
              <div class="absolute inset-0 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:28px_28px] opacity-15"></div>
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-orange-600/20 rounded-full blur-3xl pointer-events-none group-hover:bg-orange-600/30 transition-colors duration-500"></div>

              <!-- Top Header Overlay -->
              <div class="absolute top-0 left-0 right-0 p-4 sm:p-6 flex items-center justify-between z-20">
                <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-700/60 backdrop-blur-md">
                  <span class="w-2.5 h-2.5 rounded-full bg-orange-500 animate-ping"></span>
                  <span class="text-[10px] sm:text-xs font-mono font-bold tracking-widest text-zinc-200 uppercase">
                    AETHERION OFFICIAL TEASER
                  </span>
                </div>

                <div class="text-[10px] sm:text-xs font-mono text-zinc-400 bg-zinc-900/60 px-2.5 py-1 rounded-md border border-zinc-800">
                  PREVIEW ONLY
                </div>
              </div>

              <!-- Center Glowing Interactive Play Button -->
              <div class="absolute inset-0 flex items-center justify-center z-20">
                <button 
                  type="button"
                  id="play-teaser-btn"
                  aria-label="Putar Video Profil BEM FASILKOM 2026"
                  class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/10 group-hover:bg-orange-500 backdrop-blur-md border border-white/20 group-hover:border-orange-400 text-white flex items-center justify-center shadow-xl transition-all duration-300 group-hover:scale-110 active:scale-95 focus:outline-none"
                >
                  <span class="absolute inset-0 rounded-full border border-orange-500/40 animate-ping opacity-75"></span>
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 ml-1 text-white group-hover:text-zinc-950 transition-colors" fill="currentColor" viewBox="0 0 24 24">
